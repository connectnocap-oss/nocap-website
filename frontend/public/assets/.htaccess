# Vite puts content-hashed files here (index-XXXX.js, fonts...): a new build gets new
# names, so browsers can cache these for a year without ever seeing stale files.
# Wrapped in FilesMatch so it is applied after (and overrides) the root FilesMatch rules.
<IfModule mod_headers.c>
  <FilesMatch ".">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
